<script>
const BACKEND_BASE = 'http://localhost:5000';

let allGalleryImages = [];
let currentGalleryCategory = 'all';

function getGalleryImageUrl(imagePath) {

  if (!imagePath) {
    return '';
  }

  if (
    imagePath.startsWith('http://') ||
    imagePath.startsWith('https://')
  ) {
    return imagePath;
  }

  if (imagePath.startsWith('/')) {
    return BACKEND_BASE + imagePath;
  }

  return BACKEND_BASE + '/' + imagePath;
}


function renderGallery(category = 'all') {

  const container = document.getElementById('gallery-container');

  if (!container) {
    return;
  }

  const filteredImages =
    category === 'all'
      ? allGalleryImages
      : allGalleryImages.filter(item =>
          (item.category || '').toLowerCase() === category.toLowerCase()
        );


  if (filteredImages.length === 0) {

    container.innerHTML = `
      <div class="col-sm-12 text-center">
        <p>No images available in this category.</p>
      </div>
    `;

    return;
  }


  container.innerHTML = '';


  filteredImages.forEach(item => {

    const imageUrl = getGalleryImageUrl(item.image_url);

    container.innerHTML += `
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="gallery-card">

          <a href="${imageUrl}" target="_blank">
            <img
              src="${imageUrl}"
              alt="${item.title || 'Gallery image'}"
              class="img-responsive iw"
            >
          </a>

          <h5 class="mt-2">
            ${item.title || ''}
          </h5>

          <p>
            ${item.description || ''}
          </p>

        </div>
      </div>
    `;

  });

}


async function loadGallery() {

  const container = document.getElementById('gallery-container');

  if (!container) {
    return;
  }

  try {

    const response = await fetch(`${BACKEND_BASE}/api/gallery`);

    if (!response.ok) {
      throw new Error(`Gallery API returned ${response.status}`);
    }

    const data = await response.json();

    if (!data.success) {
      container.innerHTML = '<p>Failed to load gallery.</p>';
      return;
    }

    allGalleryImages = data.images || [];

    renderGallery(currentGalleryCategory);

  } catch (error) {

    console.error('Gallery loading error:', error);

    container.innerHTML =
      '<p>Error loading gallery. Please try again later.</p>';

  }

}


/* Gallery category buttons */

document.querySelectorAll('.gallery-filter').forEach(button => {

  button.addEventListener('click', function() {

    currentGalleryCategory = this.dataset.category;

    document
      .querySelectorAll('.gallery-filter')
      .forEach(btn => btn.classList.remove('active'));

    this.classList.add('active');

    renderGallery(currentGalleryCategory);

  });

});


loadGallery();
</script>
